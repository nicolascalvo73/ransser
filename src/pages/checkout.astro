---
import BaseLayout from '../layouts/BaseLayout.astro';
import { MP_CHECKOUT_URL } from '../config/checkout';
import { PROVINCES } from '../lib/checkout-form';
import { SITE } from '../data/site';
import { withBase } from '../lib/url';
import type { CustomerData } from '../types';

interface FieldDef {
  name: keyof CustomerData;
  label: string;
  type?: 'text' | 'email' | 'tel';
  autocomplete: string;
  inputmode?: 'tel' | 'numeric';
  wide?: boolean;
}
const fields: FieldDef[] = [
  { name: 'name', label: 'Nombre y apellido', autocomplete: 'name', wide: true },
  { name: 'email', label: 'Email', type: 'email', autocomplete: 'email' },
  { name: 'phone', label: 'Teléfono (con código de área)', type: 'tel', autocomplete: 'tel', inputmode: 'tel' },
  { name: 'address', label: 'Calle y número', autocomplete: 'street-address', wide: true },
  { name: 'city', label: 'Ciudad', autocomplete: 'address-level2' },
  { name: 'postalCode', label: 'Código postal', autocomplete: 'postal-code', inputmode: 'numeric' },
];
const home = withBase('/');
---

<BaseLayout title="Confirmar pedido | Ransser" description="Revisá tu pedido, cargá tus datos de envío y pagá con Mercado Pago o consultá por WhatsApp." noindex fab={false}>
  <div class="container checkout">
    <h1>Confirmar pedido</h1>

    <section class="empty" data-no-items hidden>
      <p class="empty__t">Tu pedido está vacío.</p>
      <p>Sumá productos y volvé para confirmarlo.</p>
      <a class="btn btn--primary" href={`${home}#indumentaria`}>Ver productos</a>
    </section>

    <div class="layout" data-with-items hidden>
      <section class="summary" aria-labelledby="summary-title">
        <h2 id="summary-title">Tu pedido <span data-summary-count></span></h2>
        <ul class="slist" data-summary-list></ul>
        <div class="stotal"><span>Total estimado</span><strong data-summary-total></strong></div>
        <p class="note">Precios de ejemplo (relevados el 1/10/2026). Antes de cobrar confirmamos stock, talles y costo de envío.</p>
        <button class="linkbtn" type="button" data-clear>Vaciar pedido</button>
      </section>

      <form id="checkout-form" class="form" novalidate data-mp-url={MP_CHECKOUT_URL} data-wa-number={SITE.whatsapp} aria-labelledby="form-title">
        <h2 id="form-title">Tus datos y el envío</h2>
        <p class="note">Enviamos a todo el país.</p>

        <div class="fields">
          {
            fields.map((f) => (
              <div class:list={['field', { 'field--wide': f.wide }]}>
                <label for={`f-${f.name}`}>{f.label}</label>
                <input id={`f-${f.name}`} name={f.name} type={f.type ?? 'text'} autocomplete={f.autocomplete} inputmode={f.inputmode} aria-describedby={`err-${f.name}`} required />
                <p class="err" id={`err-${f.name}`} hidden />
              </div>
            ))
          }
          <div class="field">
            <label for="f-province">Provincia</label>
            <select id="f-province" name="province" autocomplete="address-level1" aria-describedby="err-province" required>
              <option value="">Elegí una provincia</option>
              {PROVINCES.map((p) => (<option value={p}>{p}</option>))}
            </select>
            <p class="err" id="err-province" hidden />
          </div>
          <div class="field field--wide">
            <label for="f-notes">Notas (opcional)</label>
            <textarea id="f-notes" name="notes" rows="3" placeholder="Talle, color, horario de contacto…"></textarea>
          </div>
        </div>

        <div class="pay">
          <button class="btn btn--primary btn--block" type="submit" data-pay>Pagar con Mercado Pago</button>
          <a class="btn btn--wa btn--block" data-wa-order href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener">Consultar por WhatsApp</a>
          <p class="note" role="status" aria-live="polite" data-checkout-status></p>
          <p class="note">Demo: el botón de pago lleva a un link de ejemplo de Mercado Pago. El cobro real se conecta al entregar el sitio.</p>
        </div>
      </form>
    </div>
  </div>
</BaseLayout>

<template id="summary-row-template">
  <li class="srow">
    <div class="srow__info">
      <p class="srow__name"></p>
      <p class="srow__variant"></p>
      <p class="srow__unit"></p>
      <div class="srow__qty">
        <button type="button" data-qty-dec aria-label="Restar una unidad">−</button>
        <output class="srow__n"></output>
        <button type="button" data-qty-inc aria-label="Sumar una unidad">+</button>
      </div>
    </div>
    <div class="srow__side">
      <p class="srow__price"></p>
      <button class="srow__remove" type="button" data-remove aria-label="Quitar del pedido">Quitar</button>
    </div>
  </li>
</template>

<script>
  import '../scripts/checkout-ui';
</script>

<style is:global>
  .checkout { padding-block: 1.5rem 4rem; display: grid; gap: 1.5rem; }
  .checkout h1 { font-size: clamp(3.5rem, 8vw, 7rem); }
  .checkout h2 { font-size: 2.5rem; line-height: 1; }
  .checkout .empty__t { font: 800 2.5rem/1 var(--font-display); text-transform: uppercase; color: var(--text); }
  .checkout .empty { display: grid; justify-items: start; gap: 0.75rem; padding-block: 3rem; text-align: center; color: var(--text-2); }
  .checkout .empty[hidden], .checkout .layout[hidden] { display: none; }
  .checkout .layout { display: grid; gap: 1.5rem; align-items: start; }
  .checkout .summary, .checkout .form { display: grid; gap: 1rem; padding: 1.25rem; background: var(--surface); border: 1px solid var(--line); }
  .checkout .note { color: var(--text-2); font-size: 0.8rem; }
  .checkout .slist { display: grid; }
  .srow { display: flex; justify-content: space-between; gap: 1rem; padding-block: 0.9rem; border-bottom: 1px solid var(--line); }
  .srow__name { font: 800 1.625rem/1.05 var(--font-display); text-transform: uppercase; }
  .srow__variant, .srow__unit { color: var(--text-2); font: 400 0.8125rem var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; }
  .srow__variant:empty { display: none; }
  .srow__qty { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 0.6rem; }
  .srow__qty button { display: grid; place-items: center; min-width: var(--tap); min-height: var(--tap); background: none; border: 1.5px solid var(--text); color: var(--text); font: 600 1.25rem var(--font-body); cursor: pointer; transition: background-color 0.2s, color 0.2s; }
  .srow__qty button:hover { background: var(--text); color: var(--on-accent); }
  .srow__n { min-width: 2.25rem; text-align: center; font: 500 1rem var(--font-mono); }
  .srow__side { display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; }
  .srow__price { font: 900 1.625rem/1 var(--font-display); white-space: nowrap; }
  .srow__remove { min-height: var(--tap); padding-inline: 0.5rem; background: none; border: 0; color: var(--text-2); text-decoration: underline; cursor: pointer; font: inherit; }
  .srow__remove:hover { color: var(--accent); }
  .stotal { display: flex; justify-content: space-between; align-items: baseline; font-size: var(--fs-lg); }
  .stotal strong { font: 900 3rem/1 var(--font-display); color: var(--text); }
  .linkbtn { justify-self: start; min-height: var(--tap); background: none; border: 0; color: var(--text-2); text-decoration: underline; cursor: pointer; }
  .linkbtn:hover { color: var(--text); }

  .fields { display: grid; gap: 0.9rem; }
  .field { display: grid; gap: 0.35rem; }
  .field label { font: 500 0.8125rem var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
  .field input, .field select, .field textarea { width: 100%; min-height: var(--tap); padding: 0.6rem 0.8rem; background: var(--bg); color: var(--text); border: 1.5px solid var(--line-2); font: inherit; }
  .field textarea { resize: vertical; }
  .field input:hover, .field select:hover, .field textarea:hover { border-color: var(--line-2); }
  .field [aria-invalid] { border-color: var(--accent); }
  .field .err { color: var(--accent); font-size: 0.9rem; font-weight: 600; }
  .field .err::before { content: 'Error: '; }
  .field .err[hidden] { display: none; }
  .pay { display: grid; gap: 0.75rem; margin-top: 0.5rem; }
  .pay .btn[disabled] { opacity: 0.6; cursor: progress; }

  @media (min-width: 640px) {
    .checkout .fields { grid-template-columns: 1fr 1fr; }
    .checkout .field--wide { grid-column: 1 / -1; }
  }
  @media (min-width: 960px) {
    .checkout .layout { grid-template-columns: 1fr 1.15fr; gap: 2rem; }
    .checkout .summary { position: sticky; top: 8rem; }
  }
</style>
