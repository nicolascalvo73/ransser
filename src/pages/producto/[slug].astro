---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductImage from '../../components/ui/ProductImage.astro';
import ProductCard from '../../components/ui/ProductCard.astro';
import SizeTable from '../../components/ui/SizeTable.astro';
import Icon from '../../components/ui/Icon.astro';
import { PRODUCTS, getCategory, related } from '../../lib/products';
import { formatPrice } from '../../lib/format';
import { productMessage, whatsappHref } from '../../lib/whatsapp';
import { productStructuredData } from '../../lib/seo';
import { SITE } from '../../data/site';
import { withBase } from '../../lib/url';
import type { Product } from '../../types';

export const getStaticPaths = (() => PRODUCTS.map((product) => ({ params: { slug: product.slug }, props: { product } }))) satisfies GetStaticPaths;

interface Props {
  product: Product;
}
const { product } = Astro.props;
const category = getCategory(product.category);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const hasSizes = product.sizes !== null;
const others = related(product);
const description = `${product.summary} ${product.price !== null ? `${formatPrice(product.price)} (precio de ejemplo).` : 'Consultá el precio por WhatsApp.'}`;
---

<BaseLayout title={`${product.name} | Ransser`} description={description} jsonLd={[productStructuredData(product, canonical)]}>
  <article class="container pdp" style={`--accent:${category.accent}`}>
    <nav class="crumbs" aria-label="Migas de pan">
      <a href={withBase('/')}>Inicio</a> <span aria-hidden="true">/</span>
      <a href={`${withBase('/')}#${category.id}`}>{category.name}</a> <span aria-hidden="true">/</span>
      <span aria-current="page">{product.name}</span>
    </nav>

    <div class="pdp__grid">
      <div class="pdp__media">
        <ProductImage product={product} loading="eager" big sizes="(min-width: 900px) 34rem, 100vw" />
      </div>

      <div class="pdp__info">
        {product.badge && <p class="pdp__badge">{product.badge}</p>}
        <h1>{product.name}</h1>

        <p class="pdp__price">
          {
            product.price !== null ? (
              <>
                <strong>{formatPrice(product.price)}</strong>
                {product.price_before && <s>{formatPrice(product.price_before)}</s>}
              </>
            ) : (
              <strong class="pdp__ask">Consultar precio</strong>
            )
          }
        </p>
        <p class="pdp__sample">Precio de ejemplo, relevado el 1/10/2026.</p>

        <p class="pdp__desc">{product.description}</p>
        {product.description_is_placeholder && <p class="pdp__sample">Descripción provisoria: la ficha completa se carga desde el catálogo real.</p>}

        {
          product.features.length > 0 && (
            <ul class="feats" aria-label="Características">
              {product.features.map((f) => (<li><Icon name="check" size={16} /> {f}</li>))}
            </ul>
          )
        }

        {
          product.specs.length > 0 && (
            <dl class="specs">
              {product.specs.map((s) => (<><dt>{s.label}</dt><dd>{s.value}</dd></>))}
            </dl>
          )
        }

        {
          product.price !== null && (
            <div class="buy">
              {hasSizes && (
                <fieldset class="sizepick" id="size-picker">
                  <legend>Talle {product.sizes_is_placeholder && <small>(a confirmar)</small>}</legend>
                  <div class="sizepick__opts">
                    {product.sizes!.map((s) => (
                      <label class="size">
                        <input type="radio" name="size" value={s} />
                        <span>{s}</span>
                      </label>
                    ))}
                  </div>
                  <p class="sizepick__err" data-size-error hidden role="alert">Elegí un talle para sumarlo al pedido.</p>
                </fieldset>
              )}

              <div class="qtyrow">
                <div class="qty" role="group" aria-label="Cantidad">
                  <button type="button" data-step="-1" data-step-target="#qty" aria-label="Restar una unidad"><Icon name="minus" size={16} /></button>
                  <input id="qty" type="number" inputmode="numeric" min="1" max="99" value="1" aria-label="Cantidad" />
                  <button type="button" data-step="1" data-step-target="#qty" aria-label="Sumar una unidad"><Icon name="plus" size={16} /></button>
                </div>
                <button
                  class="btn btn--primary pdp__add"
                  type="button"
                  data-add-to-cart
                  data-id={product.id}
                  data-name={product.name}
                  data-price={product.price}
                  data-qty-from="#qty"
                  data-variant-from={hasSizes ? '#size-picker' : undefined}
                >
                  <Icon name="plus" size={18} /> Sumar al pedido
                </button>
              </div>
            </div>
          )
        }

        <a class="btn btn--wa btn--block" href={whatsappHref(SITE.whatsapp, productMessage(product))} target="_blank" rel="noopener">
          <Icon name="whatsapp" size={18} /> Consultar por WhatsApp
        </a>

        {product.sizes && <SizeTable sizes={product.sizes} placeholder={product.sizes_is_placeholder} />}
      </div>
    </div>

    {
      others.length > 0 && (
        <section class="more" aria-labelledby="more-title">
          <h2 id="more-title">Mirá también</h2>
          <ul class="more__grid">
            {others.map((p) => (<li><ProductCard product={p} /></li>))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .pdp { padding-block: 1rem 3rem; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; min-height: var(--tap); color: var(--text-2); font-size: var(--fs-sm); }
  .crumbs a { text-decoration: none; display: inline-flex; align-items: center; min-height: var(--tap); }
  .crumbs a:hover { color: var(--accent); }
  .crumbs [aria-current] { color: var(--text); }
  .pdp__grid { display: grid; gap: 1.5rem; margin-top: 0.5rem; }
  .pdp__info { display: grid; gap: 1rem; align-content: start; }
  .pdp__badge { justify-self: start; padding: 0.2rem 0.6rem; border-radius: 999px; background: var(--accent); color: var(--bg); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
  .pdp__price { display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap; }
  .pdp__price strong { font: 800 clamp(2.2rem, 7vw, 3rem)/1 var(--font-display); color: var(--accent); }
  .pdp__price s { color: var(--text-2); }
  .pdp__ask { color: var(--text) !important; }
  .pdp__sample { color: var(--text-2); font-size: 0.8rem; margin-top: -0.5rem; }
  .pdp__desc { color: var(--text); max-width: 60ch; }
  .feats { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .feats li { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.3rem 0.7rem; background: var(--surface); border: 1px solid var(--line); border-radius: 999px; font-size: var(--fs-sm); }
  .feats :global(svg) { color: var(--accent); }
  .specs { display: grid; grid-template-columns: auto 1fr; gap: 0.35rem 1.25rem; margin: 0; padding: 1rem; background: var(--surface); border-radius: var(--radius-sm); font-size: var(--fs-sm); }
  .specs dt { color: var(--text-2); }
  .specs dd { margin: 0; }

  .buy { display: grid; gap: 1rem; padding-top: 0.5rem; }
  .sizepick { margin: 0; padding: 0; border: 0; display: grid; gap: 0.5rem; }
  .sizepick legend { padding: 0; font-weight: 700; margin-bottom: 0.5rem; }
  .sizepick small { font-weight: 400; color: var(--text-2); }
  .sizepick__opts { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .size { position: relative; }
  .size input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .size span { display: grid; place-items: center; min-width: var(--tap); min-height: var(--tap); padding-inline: 0.75rem; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface); font-weight: 700; }
  .size input:checked + span { background: var(--accent); border-color: var(--accent); color: var(--bg); }
  .size input:focus-visible + span { outline: 3px solid var(--accent); outline-offset: 3px; }
  .sizepick__err { color: var(--accent); font-size: var(--fs-sm); }
  .sizepick__err[hidden] { display: none; }

  .qtyrow { display: grid; grid-template-columns: auto 1fr; gap: 0.75rem; }
  .qty { display: inline-flex; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface); }
  .qty button { display: grid; place-items: center; width: var(--tap); min-height: var(--tap); background: none; border: 0; color: var(--text); cursor: pointer; }
  .qty button:hover { background: var(--surface-2); }
  .qty input { width: 3rem; text-align: center; background: none; border: 0; color: var(--text); font: 700 1rem var(--font-body); -moz-appearance: textfield; appearance: textfield; }
  .qty input::-webkit-outer-spin-button, .qty input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  :global(.btn.is-added) { background: var(--accent) !important; color: var(--bg) !important; }

  .more { margin-top: 3.5rem; display: grid; gap: 1.25rem; }
  .more__grid { display: grid; gap: 1rem; }
  .more__grid > li { display: flex; }
  .more__grid > li > :global(.card) { flex: 1; }
  @media (min-width: 640px) { .more__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 900px) {
    .pdp__grid { grid-template-columns: 1fr 1fr; gap: 3rem; }
    .pdp__media { position: sticky; top: 7rem; align-self: start; }
    .more__grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
