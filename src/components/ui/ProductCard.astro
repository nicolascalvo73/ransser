---
import { formatPrice } from '../../lib/format';
import { productHref } from '../../lib/products';
import { productMessage, whatsappHref } from '../../lib/whatsapp';
import { SITE } from '../../data/site';
import { withBase } from '../../lib/url';
import type { Product } from '../../types';
import ProductImage from './ProductImage.astro';

interface Props {
  product: Product;
}
const { product } = Astro.props;
const href = withBase(productHref(product));
---

<article class="card" data-card data-rv>
  <a class="card__media" href={href} tabindex="-1" aria-hidden="true">
    <ProductImage product={product} />
    {product.badge && <span class="card__badge">{product.badge}</span>}
  </a>
  <div class="card__body">
    <h3 class="card__name"><a href={href}>{product.name}</a></h3>
    <p class="card__summary">{product.summary}</p>
    <p class="card__price">
      {
        product.price !== null ? (
          <>
            <strong>{formatPrice(product.price)}</strong>
            {product.price_before && <s><span class="sr">Antes </span>{formatPrice(product.price_before)}</s>}
          </>
        ) : (
          <strong class="card__ask">Consultar precio</strong>
        )
      }
    </p>
    {
      product.price === null ? (
        <a class="btn btn--primary card__btn" href={whatsappHref(SITE.whatsapp, productMessage(product))} target="_blank" rel="noopener">Consultar por WhatsApp</a>
      ) : product.sizes ? (
        <button
          class="btn card__btn"
          type="button"
          data-pick-size
          data-id={product.id}
          data-name={product.name}
          data-price={product.price}
          data-price-text={formatPrice(product.price)}
          data-sizes={product.sizes.join(',')}
          data-sizes-placeholder={product.sizes_is_placeholder ? '' : undefined}
          data-href={href}
        >
          Elegir talle
        </button>
      ) : (
        <button class="btn btn--primary card__btn" type="button" data-add-to-cart data-id={product.id} data-name={product.name} data-price={product.price}>
          Sumar al pedido
        </button>
      )
    }
  </div>
</article>

<style>
  .card { display: flex; flex-direction: column; gap: 1.1rem; }
  .card__media { position: relative; display: block; text-decoration: none; }
  .card__badge { position: absolute; top: 1rem; left: 1rem; padding: 0.4rem 0.65rem; background: var(--accent); color: var(--on-accent); font: 500 0.75rem var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; }
  .card__body { display: flex; flex-direction: column; gap: 0.65rem; flex: 1; }
  .card__name { font-size: 2rem; }
  .card__name a { text-decoration: none; }
  .card__name a:hover { color: var(--accent); }
  .card__summary { color: var(--text-2); flex: 1; text-wrap: pretty; }
  .card__price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.9rem; }
  .card__price strong { font: 900 2.125rem/1 var(--font-display); }
  .card__ask { color: var(--text-3); }
  .card__btn { align-self: flex-start; }
</style>
