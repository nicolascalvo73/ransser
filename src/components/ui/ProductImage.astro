---
import { Image } from 'astro:assets';
import { getImage } from '../../lib/images';
import { getCategory } from '../../lib/products';
import type { Product } from '../../types';
import Icon from './Icon.astro';

interface Props {
  product: Pick<Product, 'image' | 'imageAlt' | 'category' | 'name'>;
  loading?: 'lazy' | 'eager';
  sizes?: string;
  /** Ficha de producto: sin efectos de zoom. */
  big?: boolean;
}
const { product, loading = 'lazy', sizes = '(min-width: 1024px) 26rem, 90vw', big = false } = Astro.props;
const category = getCategory(product.category);
const fx = !big;
---

<div class:list={['pimg', { 'pimg--big': big }]}>
  <div class="pimg__hover" data-ph-hover={fx ? '' : undefined}>
    {
      product.image ? (
        <Image src={getImage(product.image)} alt={product.imageAlt} {loading} {sizes} class="pimg__img" data-ph-inner={fx ? '' : undefined} />
      ) : (
        // Placeholder: la foto real todavía no está cargada.
        <div class="pimg__ph" role="img" aria-label={`Foto real a cargar: ${product.imageAlt}`}>
          <Icon name={category.icon} size={big ? 96 : 64} />
          <span class="pimg__label">Foto real a cargar</span>
        </div>
      )
    }
  </div>
</div>

<style>
  .pimg { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: var(--surface); }
  .pimg__hover { position: absolute; inset: 0; }
  .pimg__img { width: 100%; height: 100%; object-fit: cover; }
  .pimg__ph { height: 100%; display: grid; place-content: center; justify-items: center; gap: 0.9rem; color: var(--text-2); background: repeating-linear-gradient(135deg, rgb(241 240 234 / 5%) 0 2px, transparent 2px 14px), var(--surface); }
  .pimg__label { font: 500 0.75rem var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; }
</style>
