---
import { Image } from 'astro:assets';
import type { Evento } from '../../data/events.schema';
import { getImage } from '../../lib/images';
import { SITE } from '../../data/site';
import { TYPE_LABEL, eventDateParts, mapsHref } from '../../lib/events';
import { eventMessage, whatsappHref } from '../../lib/whatsapp';

interface Props {
  event: Evento;
  /** Card grande en desktop (el evento destacado). */
  featured?: boolean;
}
const { event: e, featured = false } = Astro.props;
const d = eventDateParts(e);
---

<article class:list={['ev', { 'ev--feat': featured }]} data-evento data-tipo={e.tipo} data-rv aria-labelledby={`ev-${e.id}`}>
  {
    e.imagen && (
      <div class="ev__img">
        <Image src={getImage(e.imagen)} alt={e.ejemplo ? `Imagen de ejemplo del evento ${e.titulo}` : e.titulo} width={800} height={500} loading="lazy" sizes={featured ? '(min-width: 1024px) 40rem, 100vw' : '(min-width: 1024px) 26rem, (min-width: 640px) 50vw, 100vw'} />
      </div>
    )
  }
  <div class="ev__body">
    <div class="ev__top">
      <span class={`badge badge--${e.tipo}`}>{TYPE_LABEL[e.tipo]}</span>
      {e.ejemplo && <span class="badge badge--ej">Ejemplo</span>}
      {featured && <span class="badge badge--feat">Destacado</span>}
    </div>

    <time class="ev__date" datetime={e.fecha} aria-label={d.long}>
      <span class="ev__day" aria-hidden="true">{d.day}</span>
      <span class="ev__month" aria-hidden="true">{d.month}</span>
      <span class="ev__time" aria-hidden="true">{d.weekday} · {d.time} hs</span>
    </time>

    <h3 id={`ev-${e.id}`} class="ev__title">{e.titulo}</h3>
    <p class="ev__where">{e.lugar} · {e.ciudad}, {e.provincia}</p>
    <p class="ev__desc">{e.descripcion}</p>

    {e.tieneStand && <p class="ev__stand"><span aria-hidden="true">◆</span> Ransser va a estar con stand</p>}

    <div class="ev__actions">
      <a class="btn btn--primary" href={whatsappHref(SITE.whatsapp, eventMessage(e, d.long))} target="_blank" rel="noopener noreferrer">Consultar por WhatsApp</a>
      <a class="btn" href={mapsHref(e)} target="_blank" rel="noopener noreferrer">Cómo llegar</a>
      {e.linkInfo && <a class="btn" href={e.linkInfo} target="_blank" rel="noopener noreferrer">Más info</a>}
    </div>
  </div>
</article>

<style>
  .ev { display: flex; flex-direction: column; height: 100%; background: var(--surface); border: 1px solid var(--line); }
  .ev__img { aspect-ratio: 16 / 10; overflow: hidden; background: var(--surface-2); }
  .ev__img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .ev__body { display: flex; flex-direction: column; gap: 0.8rem; padding: 1.4rem; flex: 1; }
  .ev__top { display: flex; flex-wrap: wrap; gap: 0.5rem; }

  /* Tipos: variantes de la paleta (naranja relleno / hueso relleno / naranja contorno). */
  .badge { padding: 0.35rem 0.65rem; font: 500 0.75rem/1 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; border: 1.5px solid transparent; }
  .badge--rodada { background: var(--accent); color: var(--on-accent); }
  .badge--motoencuentro { background: var(--text); color: var(--on-accent); }
  .badge--ride { border-color: var(--accent); color: var(--accent); }
  .badge--ej { border-color: var(--line-2); color: var(--text-2); }
  .badge--feat { border-color: var(--text); color: var(--text); }

  .ev__date { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 0.6rem; }
  .ev__day { font: 900 clamp(3.5rem, 6vw, 4.75rem)/0.9 var(--font-display); }
  .ev__month { font: 900 2rem/1 var(--font-display); text-transform: uppercase; color: var(--accent); }
  .ev__time { flex-basis: 100%; margin-top: 0.3rem; font: 500 0.875rem var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-3); }
  .ev__title { font-size: clamp(2rem, 3vw, 2.5rem); }
  .ev__where { color: var(--text-3); }
  .ev__desc { color: var(--text-2); text-wrap: pretty; flex: 1; }
  .ev__stand { display: flex; align-items: center; gap: 0.6rem; padding: 0.7rem 0.9rem; border-left: 4px solid var(--accent); background: var(--surface-2); color: var(--accent); font-weight: 600; }
  .ev__actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 0.4rem; }
  .ev__actions .btn { padding-inline: 1.1rem; font-size: 0.95rem; }

  @media (min-width: 1024px) {
    .ev--feat { flex-direction: row; }
    .ev--feat .ev__img { aspect-ratio: auto; flex: 0 0 46%; }
    .ev--feat .ev__img :global(img) { object-position: left center; }
    .ev--feat .ev__body { padding: 2rem; }
  }
</style>
