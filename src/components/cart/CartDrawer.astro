---
import { MAX_QTY } from '../../lib/cart';
import { withBase } from '../../lib/url';
---

<p class="visually-hidden" role="status" aria-live="polite" data-cart-live></p>

<dialog id="cart-drawer" class="drawer" aria-labelledby="cart-title" data-max-qty={MAX_QTY}>
  <div class="drawer__panel">
    <header class="drawer__head">
      <h2 id="cart-title">Tu pedido</h2>
      <button class="btn drawer__close" type="button" data-cart-close>Cerrar</button>
    </header>

    <div class="drawer__body">
      <div class="drawer__empty" data-cart-empty>
        <p class="drawer__empty-t">Todavía no sumaste nada.</p>
        <p>Elegí lo que necesites para el viaje y lo armamos acá.</p>
        <a class="btn btn--primary" href={`${withBase('/')}#indumentaria`} data-cart-close>Ver productos</a>
      </div>
      <ul class="drawer__list" data-cart-list></ul>
    </div>

    <footer class="drawer__foot" data-cart-foot hidden>
      <div class="drawer__total"><span>Total estimado</span><strong data-cart-total></strong></div>
      <p class="drawer__note">Precios de ejemplo. Stock, talles y costo de envío se confirman antes de pagar.</p>
      <a class="btn btn--primary btn--block" href={withBase('/checkout')}>Confirmar pedido</a>
      <button class="drawer__clear" type="button" data-cart-clear>Vaciar pedido</button>
    </footer>
  </div>
</dialog>

<template id="cart-row-template">
  <li class="row">
    <div class="row__info">
      <p class="row__name"></p>
      <p class="row__variant"></p>
      <div class="row__qty">
        <button type="button" data-qty-dec aria-label="Restar una unidad">−</button>
        <output class="row__n"></output>
        <button type="button" data-qty-inc aria-label="Sumar una unidad">+</button>
      </div>
    </div>
    <div class="row__side">
      <p class="row__price"></p>
      <button class="row__remove" type="button" data-remove aria-label="Quitar del pedido">Quitar</button>
    </div>
  </li>
</template>

<style is:global>
  html:has(dialog.drawer[open]) { overflow: hidden; }

  /* La entrada y la salida las anima GSAP (src/scripts/motion/drawer.ts); sin JS abre y cierra en seco. */
  dialog.drawer { margin: 0 0 0 auto; padding: 0; border: 0; border-left: 1px solid var(--line); width: min(480px, 100vw); max-width: 100vw; height: 100dvh; max-height: 100dvh; background: var(--surface-2); color: var(--text); }
  dialog.drawer::backdrop { background: rgb(14 15 16 / calc(0.78 * var(--bo, 1))); }

  .drawer__panel { display: flex; flex-direction: column; height: 100%; }
  .drawer__head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--line); }
  .drawer__head h2 { font-size: 2.5rem; line-height: 1; }
  .drawer__close { min-height: var(--tap); padding: 0 1.1rem; }
  .drawer__body { flex: 1; overflow-y: auto; padding: 0.5rem 1.5rem; }
  .drawer__empty { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; padding-block: 3rem; color: var(--text-2); }
  .drawer__empty[hidden] { display: none; }
  .drawer__empty-t { font: 800 2.25rem/1 var(--font-display); text-transform: uppercase; color: var(--text); }
  .drawer__list { display: grid; }

  .row { display: flex; justify-content: space-between; gap: 1rem; padding-block: 1.25rem; border-bottom: 1px solid var(--line); }
  .row__name { font: 800 1.625rem/1.05 var(--font-display); text-transform: uppercase; }
  .row__variant { color: var(--text-2); font: 400 0.8125rem var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; min-height: 1.2em; }
  .row__qty { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 0.75rem; }
  .row__qty button { display: grid; place-items: center; min-width: var(--tap); min-height: var(--tap); background: none; border: 1.5px solid var(--text); color: var(--text); font: 600 1.25rem var(--font-body); cursor: pointer; transition: background-color 0.2s, color 0.2s; }
  .row__qty button:hover { background: var(--text); color: var(--on-accent); }
  .row__n { min-width: 2.25rem; text-align: center; font: 500 1rem var(--font-mono); }
  .row__side { display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; }
  .row__price { font: 900 1.625rem/1 var(--font-display); white-space: nowrap; }
  .row__remove { min-height: var(--tap); padding-inline: 0.5rem; background: none; border: 0; color: var(--text-2); text-decoration: underline; cursor: pointer; font: inherit; }
  .row__remove:hover { color: var(--accent); }

  .drawer__foot { display: grid; gap: 1rem; padding: 1.25rem 1.5rem 1.5rem; border-top: 1px solid var(--line); background: var(--bg); }
  .drawer__foot[hidden] { display: none; }
  .drawer__total { display: flex; justify-content: space-between; align-items: baseline; font: 500 0.8125rem var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-2); }
  .drawer__total strong { font: 900 2.75rem/1 var(--font-display); color: var(--text); letter-spacing: 0; }
  .drawer__note { color: var(--text-2); font-size: 0.875rem; }
  .drawer__clear { justify-self: start; min-height: var(--tap); background: none; border: 0; color: var(--text-2); text-decoration: underline; cursor: pointer; font: inherit; }
  .drawer__clear:hover { color: var(--text); }
</style>
