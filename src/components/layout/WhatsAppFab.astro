---
import { SITE } from '../../data/site';
import { generalMessage, whatsappHref } from '../../lib/whatsapp';
import Icon from '../ui/Icon.astro';
---

<a class="fab" href={whatsappHref(SITE.whatsapp, generalMessage())} target="_blank" rel="noopener" aria-label="Hablame por WhatsApp">
  <Icon name="whatsapp" size={28} />
</a>

<style>
  .fab { position: fixed; right: 1rem; bottom: 1rem; z-index: 30; display: grid; place-items: center; width: 3.5rem; height: 3.5rem; background: var(--accent); color: var(--on-accent); transition: background-color 0.2s; }
  .fab:hover { background: var(--text); }
  :global(html:has(dialog[open])) .fab { display: none; }
</style>
