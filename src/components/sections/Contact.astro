---
import { SITE } from '../../data/site';
import { generalMessage, whatsappHref } from '../../lib/whatsapp';
---

<section class="container contact" id="contacto" aria-labelledby="contacto-title">
  <div class="box" data-rv>
    <div class="box__text">
      <p class="eyebrow">Contacto</p>
      <h2 id="contacto-title">Hablame al privado</h2>
    </div>
    <div class="box__links">
      <a class="phone" href={whatsappHref(SITE.whatsapp, generalMessage())} target="_blank" rel="noopener">{SITE.whatsappLabel}</a>
      <a class="ig" href={SITE.instagram} target="_blank" rel="noopener">{SITE.instagramHandle}</a>
    </div>
  </div>
</section>

<style>
  .contact { padding-block: 7rem 5rem; }
  .box { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 3rem; padding: clamp(2rem, 6vw, 5rem); background: var(--surface); border: 1px solid var(--line); }
  .box__text { display: flex; flex-direction: column; gap: 1.25rem; }
  h2 { font-size: clamp(3rem, 8vw, 8rem); line-height: 0.9; }
  .box__links { display: flex; flex-direction: column; align-items: flex-start; gap: 0.75rem; }
  .phone { font: 800 clamp(2rem, 3.6vw, 3.25rem)/1.1 var(--font-display); text-decoration: none; }
  .phone:hover, .ig:hover { color: var(--text); }
  .ig { display: inline-flex; align-items: center; min-height: var(--tap); font: 500 0.95rem var(--font-mono); letter-spacing: 0.04em; color: var(--accent); }
</style>
