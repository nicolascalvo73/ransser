---
import { CATEGORIES } from '../../data/categories';
import { productsByCategory } from '../../lib/products';
import { withBase } from '../../lib/url';
import SplitTitle from '../ui/SplitTitle.astro';
---

<section class="container cats" id="categorias" aria-labelledby="cats-title">
  <h2 id="cats-title" data-title><SplitTitle text="Elegí por dónde arrancar" accent={1} /></h2>
  <ul class="rows">
    {
      CATEGORIES.map((c, i) => {
        const n = productsByCategory(c.id).length;
        return (
          <li>
            <a class="row" href={`${withBase('/')}#${c.id}`} data-row>
              <span class="row__fill" data-fill aria-hidden="true" />
              <span class="row__n">{String(i + 1).padStart(2, '0')}</span>
              <span class="row__text">
                <span class="row__name">{c.name}</span>
                <span class="row__tag">{c.tagline}</span>
              </span>
              <span class="row__count">{n} {n === 1 ? 'producto' : 'productos'} <span class="row__arrow" data-arrow aria-hidden="true">↗</span></span>
            </a>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .cats { padding-block: 7rem 2.5rem; }
  h2 { font-size: clamp(2.75rem, 7vw, 7rem); margin-bottom: 3.5rem; }
  .rows { border-bottom: 1px solid var(--line); }
  .rows li { border-top: 1px solid var(--line); }
  .row { position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 2.5rem; padding: 2.5rem 1.25rem; overflow: hidden; text-decoration: none; color: var(--text); }
  .row__fill { position: absolute; inset: 0; background: var(--accent); transform: scaleY(0); transform-origin: 50% 100%; }
  /* Sin JS el relleno sube con CSS; con motion.ts lo controla GSAP (data-fill + clase .is-js). */
  :global(html:not(.has-motion)) .row:hover, :global(html:not(.has-motion)) .row:focus-visible { color: var(--on-accent); }
  :global(html:not(.has-motion)) .row:hover .row__fill, :global(html:not(.has-motion)) .row:focus-visible .row__fill { transform: scaleY(1); transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1); }
  .row > * { position: relative; }
  .row__n { min-width: 3rem; font: 500 0.875rem var(--font-mono); letter-spacing: 0.1em; }
  .row__text { flex: 1 1 320px; display: flex; flex-direction: column; gap: 0.4rem; }
  .row__name { font: 900 clamp(2.5rem, 6vw, 5.5rem)/0.95 var(--font-display); text-transform: uppercase; }
  .row__tag { max-width: 32rem; opacity: 0.8; }
  .row__count { display: flex; align-items: center; gap: 1.25rem; font: 500 0.875rem var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
  .row__arrow { display: inline-block; font-size: 2rem; line-height: 1; }
</style>
