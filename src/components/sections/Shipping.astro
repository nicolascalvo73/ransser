---
import SplitTitle from '../ui/SplitTitle.astro';

const steps = [
  { title: 'Elegís', text: 'Armá tu pedido en la web o consultá por WhatsApp.' },
  { title: 'Confirmamos', text: 'Te confirmamos stock, talle y costo de envío antes de que pagues.' },
  { title: 'Te llega', text: 'Enviamos a todo el país. Coordinamos el despacho con vos.' },
];
---

<section class="container ship" id="envios" aria-labelledby="envios-title">
  <p class="eyebrow" data-rv>KM 04 / Envíos a todo el país</p>
  <h2 id="envios-title" data-title><SplitTitle text="Vivas donde vivas, te llega" accent={2} /></h2>
  <div class="steps" data-steps>
    <div class="steps__bar" aria-hidden="true"></div>
    <div class="steps__line" data-line aria-hidden="true"></div>
    <ol>
      {
        steps.map((s, i) => (
          <li data-rv>
            <span class="dia" aria-hidden="true"></span>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .ship { padding-block: 7rem 5rem; }
  .ship .eyebrow { margin-bottom: 0.75rem; }
  h2 { font-size: clamp(2.75rem, 7vw, 7rem); margin-bottom: 4.5rem; }
  .steps { position: relative; }
  .steps__bar, .steps__line { position: absolute; left: 0; right: 0; top: 7px; height: 2px; }
  .steps__bar { background: var(--line); }
  .steps__line { background: var(--accent); }
  /* Sin movimiento la línea queda dibujada entera; GSAP la anima de 0 a 1 sólo si corre. */
  ol { position: relative; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 3rem 2rem; }
  li { display: flex; flex-direction: column; gap: 0.9rem; }
  .dia { display: block; width: 16px; height: 16px; background: var(--accent); transform: rotate(45deg); }
  .n { margin-top: 1rem; font: 500 0.875rem var(--font-mono); letter-spacing: 0.1em; color: var(--text-2); }
  h3 { font-size: 4rem; font-weight: 900; line-height: 0.95; }
  li p { max-width: 21rem; color: var(--text-3); text-wrap: pretty; }
</style>
