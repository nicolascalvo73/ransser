---
import Icon from '../ui/Icon.astro';

const steps = [
  { icon: 'cart', title: 'Elegís', text: 'Armá tu pedido en la web o consultá por WhatsApp.' },
  { icon: 'shield', title: 'Confirmamos', text: 'Te confirmamos stock, talle y costo de envío antes de que pagues.' },
  { icon: 'truck', title: 'Te llega', text: 'Enviamos a todo el país. Coordinamos el despacho con vos.' },
] as const;
---

<section class="section ship" id="envios" aria-labelledby="envios-title">
  <div class="container">
    <p class="eyebrow">Envíos a todo el país</p>
    <h2 id="envios-title">Vivas donde vivas, te llega</h2>
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li class="step">
            <span class="step__n">{i + 1}</span>
            <Icon name={s.icon} size={28} />
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .ship { background: var(--surface); border-block: 1px solid var(--line); }
  h2 { margin-top: 0.4rem; max-width: 22ch; }
  .steps { display: grid; gap: 1rem; margin-top: 1.75rem; counter-reset: s; }
  .step { position: relative; display: grid; gap: 0.5rem; padding: 1.25rem; background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius); }
  .step :global(svg) { color: var(--accent); }
  .step__n { position: absolute; top: 0.9rem; right: 1.1rem; font: 800 2.4rem/1 var(--font-display); color: var(--line); }
  .step p { color: var(--text-2); }
  @media (min-width: 768px) { .steps { grid-template-columns: repeat(3, 1fr); } }
</style>
